<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Registry_App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Registry_App.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Tag="page.settings" Text="Settings" />
        <StackPanel Grid.Row="1" MaxWidth="760" HorizontalAlignment="Left" Spacing="14">
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Tag="section.appearance" Text="Appearance" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Tag="setting.toolbar-alignment" Text="Toolbar alignment" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="setting.toolbar-alignment.description" Text="Left is the default for quick desktop scanning." />
                        </StackPanel>
                        <ComboBox
                            x:Name="ToolbarAlignmentSelector"
                            Grid.Column="1"
                            MinWidth="180"
                            SelectionChanged="ToolbarAlignmentSelector_SelectionChanged">
                            <ComboBoxItem Tag="choice.left" Content="Left" />
                            <ComboBoxItem Tag="choice.center" Content="Center" />
                            <ComboBoxItem Tag="choice.right" Content="Right" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Tag="setting.reg-import-mode" Text="REG file opening" />
                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tag="setting.reg-import-mode.description" Text="Choose whether a .reg file uses a modal preview here or a separate Registry window." />
                        </StackPanel>
                        <ComboBox x:Name="RegImportModeSelector" Grid.Column="1" MinWidth="180" SelectionChanged="RegImportModeSelector_SelectionChanged">
                            <ComboBoxItem Tag="choice.modal" Content="Preview in this window" />
                            <ComboBoxItem Tag="choice.new-window" Content="Open in new window" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Tag="setting.toolbar-detail" Text="Toolbar detail" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="setting.toolbar-detail.description" Text="Essential keeps rare and admin commands in overflow; Full keeps more buttons visible for testing." />
                        </StackPanel>
                        <ComboBox
                            x:Name="ToolbarDetailSelector"
                            Grid.Column="1"
                            MinWidth="180"
                            SelectionChanged="ToolbarDetailSelector_SelectionChanged">
                            <ComboBoxItem Tag="choice.essential" Content="Essential" />
                            <ComboBoxItem Tag="choice.full" Content="Full" />
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Tag="setting.window-backdrop" Text="Window backdrop" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Tag="setting.window-backdrop.description" Text="Mica stays on by default; Strong Mica increases contrast." />
                        </StackPanel>
                        <ComboBox
                            x:Name="BackdropSelector"
                            Grid.Column="1"
                            MinWidth="180"
                            SelectionChanged="BackdropSelector_SelectionChanged">
                            <ComboBoxItem Tag="choice.mica" Content="Mica" />
                            <ComboBoxItem Tag="choice.strong-mica" Content="Strong Mica" />
                            <ComboBoxItem Tag="choice.off" Content="Off" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="10">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Tag="section.safety" Text="Safety" />
                    <CheckBox Tag="setting.backup-before-destructive" Content="Export backup before destructive changes" IsChecked="True" />
                    <CheckBox Tag="setting.show-registry-warnings" Content="Show 32-bit and virtualized registry warnings" IsChecked="True" />
                    <CheckBox Tag="setting.keep-destructive-disabled" Content="Keep destructive commands disabled until an item is selected" IsChecked="True" />
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Page>
